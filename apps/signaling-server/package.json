{
  "name": "@fluxshare/signaling-server",
  "version": "0.1.0",
  "private": true,
  "description": "LAN WebRTC signaling server fallback for FluxShare.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fluxshare/protocol": "^0.1.0",
    "@fluxshare/shared": "^0.1.0",
    "@fluxshare/utils": "^0.1.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/ws": "^8.5.10",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.2"
  }
}
